# 필요한 환경변수 "이름"만 적습니다. 실제 값은 .env에 (커밋 금지)
# server/.env 로 복사해서 사용

# Claude (#8 장면 생성). 모두 비워두면 AI 없이 스텁으로 릴스 생성
# (A) 학교 BAZE 게이트웨이 키 — BAZE 사이트 > API Gateway에서 발급 (팀 기본)
#   ANTHROPIC_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/claude
#   ANTHROPIC_AUTH_TOKEN=<BAZE 키>
# (B) Anthropic Console 키를 직접 쓸 때 (A는 지우기)
#   ANTHROPIC_API_KEY=<sk-ant-…>
# (선택) 모델 바꾸기. 기본 claude-opus-5-5
CLAUDE_MODEL=
# 프론트 주소 (쉼표로 여러 개). 기본값 http://localhost:5173
ALLOWED_ORIGINS=
# SQLite 파일 경로 · 업로드 폴더 (기본: server/haru.db · server/media)
DATABASE_PATH=
MEDIA_DIR=
# AI 생성 스텁(#8 전)이 done이 되기까지 대기 초 (기본 2)
STUB_DELAY_SECONDS=

# app/.env (배포 시): 서버 주소. 개발 중에는 비워두면 vite 프록시 사용
# VITE_API_BASE=
